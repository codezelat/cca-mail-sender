# -----------------------------------------------------------------------------
# Core application settings
# -----------------------------------------------------------------------------
APP_NAME=CCA Campaign Manager
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# -----------------------------------------------------------------------------
# Infrastructure
# Use the local Postgres + Redis values below for direct development.
# Docker Compose can use the same values or override them per service.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://cca:cca@127.0.0.1:5432/cca_mail_sender
REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_BACKEND=dramatiq

# -----------------------------------------------------------------------------
# Web and asset origins
# -----------------------------------------------------------------------------
WEB_ORIGIN=http://127.0.0.1:3000
PUBLIC_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
SECURE_COOKIES=false

# -----------------------------------------------------------------------------
# Optional Brevo defaults
# If these are present, the dashboard can use them directly from the server
# environment without exposing the API key in the browser UI.
# -----------------------------------------------------------------------------
BREVO_SMTP_API_KEY=
SENDER_EMAIL=
SENDER_NAME=
